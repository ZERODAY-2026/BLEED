# ==============================================================================
# DataMind Configuration (PS1) - Environment Variables
# Copy this to .env: cp .env.example .env
# NEVER COMMIT .env TO VERSION CONTROL (Gate G5)!
# ==============================================================================

# Snowflake Connection (Person 1 will supply these)
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ACCOUNT=your_account_identifier  # e.g., xy12345.ap-south-1.aws
SNOWFLAKE_WAREHOUSE=DATAMIND_WH
SNOWFLAKE_ROLE=DATAMIND_READER

# Google Gemma Provider ('lm_studio', 'google_ai_studio', or 'simulation')
GEMMA_PROVIDER=simulation

# If using local LM Studio (Gemma 4 12B QAT):
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-12b-qat

# If using Google AI Studio:
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMMA_MODEL_ID=gemini-2.5-flash

# Engine Evaluation Mode (true = offline mock, false = live Snowflake)
OFFLINE_MOCK_MODE=true
